# keystore.properties テンプレート(実体は .gitignore)。release 署名に使う。
# 1) アップロード鍵を作成(一度だけ):
#    keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#            -validity 9125 -alias upload
# 2) 下記を実値で埋め、ファイル名を keystore.properties にして app-android/ 直下へ。
# 3) Play App Signing を有効化し、このアップロード鍵で署名した AAB を提出(B1)。
storeFile=keystore/upload-keystore.jks
storePassword=<store password>
keyAlias=upload
keyPassword=<key password>
